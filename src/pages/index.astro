---
import Layout from '../layouts/Layout.astro';
import Editable from '../components/Editable.astro';
---
<Layout title="Start"><section class="hero"><div class="container hero-grid"><div><Editable id="home.label" as="p" class="eyebrow">Gute Ideen beginnen mit einem Gespräch</Editable><Editable id="home.heading" as="h1">Gemeinsam wird aus Ihrer Idee etwas Gutes.</Editable><Editable id="home.intro" as="p" class="lead">Wir begleiten Sie mit Erfahrung, einem offenen Ohr und Lösungen, die zu Ihnen passen.</Editable><a class="button" data-edit-link="home.contact" href="/kontakt/">Lernen wir uns kennen ↗</a></div><img class="hero-image" src="/images/space.svg" data-edit-image="home.hero" alt="Abstrakte Architektur in warmen Grün- und Naturtönen" width="600" height="600"/></div></section><section class="section tinted"><div class="container"><div class="section-heading"><Editable id="home.services-label" as="p" class="eyebrow">Was wir für Sie tun</Editable><Editable id="home.services-heading" as="h2">Von der ersten Frage bis zum nächsten Schritt.</Editable></div><div class="cards">{[['Zuhören','Wir nehmen uns Zeit für Ihre Ziele und die Fragen, die Sie beschäftigen.'],['Klarheit schaffen','Wir machen Möglichkeiten verständlich und finden gemeinsam einen passenden Weg.'],['Weiterkommen','Wir setzen um, bleiben ansprechbar und begleiten Sie auch danach.']].map(([heading,body],i)=><article class="card"><span class="number">0{i+1}</span><Editable id={'home.service-'+i+'.heading'} as="h3">{heading}</Editable><Editable id={'home.service-'+i+'.body'}>{body}</Editable></article>)}</div></div></section></Layout>